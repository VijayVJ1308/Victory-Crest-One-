# Victory Crest One - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application General
APP_NAME="Victory Crest One"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# Central Database (PostgreSQL)
# For local dev without Postgres, the app provides explicit diagnostics and fallback modes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/victory_crest_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Local Offline Storage (SQLite)
LOCAL_DB_PATH="local_data/victory_crest_local.db"

# Security & Sessions
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM="HS256"

# Desktop Application Configuration
API_BASE_URL="http://127.0.0.1:8000"
DESKTOP_THEME="dark"
DESKTOP_DEV_OFFLINE_MODE=False

# Optional Third-Party Services (Disabled by default)
AI_ASSISTANT_ENABLED=False
AI_API_KEY=""
PAYMENT_SANDBOX_MODE=True
